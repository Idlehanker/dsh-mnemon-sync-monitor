{
  "name": "dsh-mnemon-sync-monitor",
  "version": "0.5.5",
  "description": "Real-time file watcher that keeps dsh-mnemon Project Documents in sync with local Markdown knowledge bases.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-mnemon",
    "file-watcher",
    "knowledge-base",
    "obsidian",
    "logseq",
    "markdown",
    "sync"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "bench": "node test/bench-concurrency.mjs"
  },
  "dependencies": {},
  "author": "Idlehanker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Idlehanker/dsh-mnemon-sync-monitor.git"
  },
  "homepage": "https://github.com/Idlehanker/dsh-mnemon-sync-monitor#readme",
  "bugs": {
    "url": "https://github.com/Idlehanker/dsh-mnemon-sync-monitor/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  }
}
